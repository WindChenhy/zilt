    .dir = "frontend",
    // @angular/build:application + outputPath.base=dist → dist/browser
    .dist = "frontend/dist/browser",
    .dev_command = @as(?[]const u8, "npm start -- --port 4200"),
    .dev_url = @as(?[]const u8, "http://localhost:4200"),
    .build_command = @as(?[]const u8, "npm run build"),
    .dev_proxy = false,
    .wait_timeout_secs = 120,
};
