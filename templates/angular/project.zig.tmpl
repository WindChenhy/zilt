//! 项目元数据与前端工程配置（Angular 19 standalone + application builder）。

pub const app_name = "{{APP_NAME}}";
pub const publisher = "{{APP_NAME}}";
pub const version = "{{VERSION}}";
pub const app_id = "{{APP_ID}}";
pub const exe_name = "app.exe";

pub const icon: ?[]const u8 = null;

